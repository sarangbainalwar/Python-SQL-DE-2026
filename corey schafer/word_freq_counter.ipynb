    "sentence=str(input(\"Enter the sentence to count words from: \"))\n",
    "words = sentence.split()\n",
    "\n",
    "main_dict = {}\n",
    "\n",
    "for word in words:\n",
    "    if word in main_dict:\n",
    "        main_dict[word]+=1\n",
    "    else:\n",
    "        main_dict[word]=1"
